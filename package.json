    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "alpinejs": "^3.16.2",
        "axios": "^1.19.0",
        "laravel-mix": "^6.0.49",
        "lodash": "^4.18.1",
        "postcss": "^8.5.26",
        "postcss-import": "^17.0.0",
        "resolve-url-loader": "^5.0.0",
        "sass": "1.79.6",
        "sass-loader": "^17.0.0",
        "tailwindcss": "^3.4.19",
        "webpack": "5.105.4"
    },
    "dependencies": {
        "@deltablot/dropzone": "7.4.4"
    }
